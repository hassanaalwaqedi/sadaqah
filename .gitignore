# ── Environment ──
.env
.env.local
# NOTE: .env.production is NOT ignored — it contains only public URLs
# and must be committed so Vercel/CI can read it during builds.

# ── OS ──
.DS_Store
Thumbs.db

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── Go ──
backend/tmp/
backend/bin/
*.exe

# ── Node ──
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo

# ── Python ──
ai-worker/__pycache__/
ai-worker/.venv/
ai-worker/*.pyc
ai-worker/.pytest_cache/
ai-worker/.ruff_cache/

# ── Docker ──
*.log

# ── SSL Certs (production) ──
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt

# ── Secrets ──
*serviceAccountKey.json
.firebase/
frontend/.firebase/
aws-production.env

# Local debug output
events*.json
events_out.txt
out.json
